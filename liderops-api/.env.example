PORT=3000

DB_HOST=seu-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=
DB_NAME=liderops
DB_SSL=true

JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
JWT_EXPIRES_IN=8h

# Primeiro administrador, criado só quando o banco ainda não tem nenhum admin
ADMIN_NOME=Administrador LiderOps
ADMIN_CARGO=Administrador
ADMIN_EMAIL=admin@liderembalagens.com.br
ADMIN_PASSWORD=123456

# Cadastro público: domínios aceitos (separados por vírgula) e código de convite inicial (6 a 8 letras/números).
# Se CODIGO_CONVITE ficar vazio, a API gera um e mostra no log; depois o admin troca pela tela.
DOMINIOS_CADASTRO=liderkraft.com.br
CODIGO_CONVITE=

# Defina como true quando o site estiver publicado com HTTPS
HTTPS=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
